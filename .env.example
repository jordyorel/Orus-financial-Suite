# Orus Suite — environment configuration template
# Copy to .env and fill in values before running scripts/run.sh

# ── OrusBroker ────────────────────────────────────────────────────────────────
BROKER_HOST=0.0.0.0
BROKER_PORT=7770
BROKER_HEALTH_PORT=7771
BROKER_WAL_FILE=/var/lib/orus/broker.wal
BROKER_CURSOR_DIR=/var/lib/orus/cursors

# ── OrusGateway ───────────────────────────────────────────────────────────────
GATEWAY_LISTEN_HOST=0.0.0.0
GATEWAY_LISTEN_PORT=7780
GATEWAY_HEALTH_PORT=7781
# ISO 8583 listener (bank/switch connects here for Direction 2)
GATEWAY_ISO_HOST=0.0.0.0
GATEWAY_ISO_PORT=7581
GATEWAY_ISO_SCHEMA=gimac
# Optional: path to a custom ISO 8583 TOML schema file (overrides GATEWAY_ISO_SCHEMA)
# GATEWAY_ISO_SCHEMA_PATH=/etc/orus/schemas/iso8583/custom_gimac.toml
# Core banking host
GATEWAY_BANK_HOST=10.0.0.1
GATEWAY_BANK_PORT=5000
GATEWAY_BANK_PREFIX=2

# ── OrusConnect ───────────────────────────────────────────────────────────────
CONNECT_LISTEN_HOST=0.0.0.0
CONNECT_LISTEN_PORT=8080
# Directory scanned at startup for operator TOML schemas (*.toml)
CONNECT_SCHEMA_DIR=./schemas/momo

# ── Shared ────────────────────────────────────────────────────────────────────
# 64-bit secret used to hash PANs — change before every deployment
PAN_HASH_SEED=CHANGE_ME_BEFORE_DEPLOY

# ── MTN Congo ─────────────────────────────────────────────────────────────────
MTN_BEARER_TOKEN=
MTN_CALLBACK_TOKEN=
MTN_API_HOST=sandbox.momodeveloper.mtn.com
MTN_API_PORT=443

# ── Airtel Congo ──────────────────────────────────────────────────────────────
AIRTEL_BEARER_TOKEN=
AIRTEL_API_HOST=openapi.airtel.africa
AIRTEL_API_PORT=443

# ── Supervision ───────────────────────────────────────────────────────────────
ORUS_LOG_DIR=/var/log/orus
